---
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '@fontsource/caveat/latin-600.css'
import '@/styles/global.css'

import Footer from '@/components/Footer.astro'
import Navbar from '@/components/Navbar.astro'
import { site } from '@/lib/site'
import { pageDates, entryMetadata } from '@/lib/content-dates'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const { title, description = site.description, noindex = false } = Astro.props
const fullTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} — the best of the Elixir community`
const canonical = new URL(Astro.url.pathname.endsWith('/') || Astro.url.pathname === '/' ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site)
const socialImage = new URL('/social-card.png', Astro.site).href
const { entries, modified } = await pageDates(Astro.url.pathname)
const section = Astro.url.pathname.split('/').filter(Boolean)[0]
const dateMetadata = { '@context': 'https://schema.org', '@type': entries.length > 1 ? 'CollectionPage' : 'WebPage', '@id': canonical.href, url: canonical.href, name: fullTitle, description, ...(modified && { dateModified: modified }), ...(entries.length && { hasPart: entries.map((entry) => entryMetadata(section, entry, Astro.url.pathname.includes('/archive'))) }) }
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} newsletter`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Elixir Community - resources, events, books and people" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Elixir Community - resources, events, books and people" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {modified && <meta property="og:updated_time" content={modified} />}
    <script type="application/ld+json" set:html={JSON.stringify(dateMetadata).replace(/</g, '\\u003c')} />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f0b10"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      // Set the theme before first paint so the page does not flash.
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('theme')
        } catch {}
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
        // Blocks with .ec-rise fade in on scroll (see ui.css).
        document.documentElement.classList.add('ec-js')
      })()
    </script>
  </head>
  <body class="flex min-h-full flex-col bg-white text-mauve-950 dark:bg-mauve-950 dark:text-white">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-mauve-950 px-4 py-2 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Navbar />
    <main id="main" class="flex-auto">
      <slot />
    </main>
    <Footer />
    <script>
      import { linkKey } from '../../server/clicks.js'

      // Count clicks on links to other sites. Sends only the destination and this page's path.
      const countClick = (event: MouseEvent) => {
        if (event.type === 'auxclick' && event.button !== 1) return
        const link = (event.target as Element | null)?.closest?.('a[href]')
        const to = link && linkKey((link as HTMLAnchorElement).href, location.href)
        if (!to || !navigator.sendBeacon) return
        const body = JSON.stringify({ to, from: location.pathname })
        navigator.sendBeacon('/api/click', new Blob([body], { type: 'application/json' }))
      }
      document.addEventListener('click', countClick, { capture: true })
      document.addEventListener('auxclick', countClick, { capture: true })

      const day = 864e5
      const today = new Date()
      today.setHours(0, 0, 0, 0)

      // Days until an event. The build fills in the date; this swaps in a live count.
      for (const el of document.querySelectorAll<HTMLElement>(
        '[data-countdown]',
      )) {
        const days = Math.round(
          (new Date(`${el.dataset.countdown}T00:00:00`).getTime() -
            today.getTime()) /
            day,
        )
        if (days > 1) el.textContent = `In ${days} days`
        else if (days === 1) el.textContent = 'Tomorrow'
        else if (days === 0) el.textContent = 'Today'
      }

      // Fade blocks in as they arrive.
      const rise = document.querySelectorAll('.ec-rise')
      if (
        matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        rise.forEach((el) => el.classList.add('is-in'))
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue
              e.target.classList.add('is-in')
              io.unobserve(e.target)
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        )
        rise.forEach((el) => io.observe(el))
      }
    </script>
  </body>
</html>
