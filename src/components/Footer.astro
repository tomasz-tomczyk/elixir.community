---
import Icon from '@/components/Icon.astro'
import Logo from '@/components/Logo.astro'
import { nav, site } from '@/lib/site'
---

<footer class="relative isolate mt-16 flex-none sm:mt-32 overflow-hidden border-t border-mauve-950/10 dark:border-white/10">
  {/* Texture: a fine dot grid that fades in toward the bottom, plus a faint accent glow. */}
  <div
    aria-hidden="true"
    class="bg-dots absolute inset-0 -z-10 [--dots-color:--theme(--color-mauve-950/0.07)] [mask-image:linear-gradient(to_bottom,transparent,black_70%)] dark:[--dots-color:--theme(--color-white/0.06)]"
  ></div>
  <div
    aria-hidden="true"
    class="absolute -bottom-40 left-1/2 -z-10 h-64 w-[48rem] -translate-x-1/2 rounded-full bg-accent-400/10 blur-3xl dark:bg-accent-500/10"
  ></div>
  <div class="container-page">
    <div class="py-12">
      <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
        <div class="max-w-md">
          <Logo />
          <p class="mt-4 text-sm/6 text-mauve-600 dark:text-mauve-400">
            Built by the community, for the community. Spot a mistake or want to
            add something?{' '}
            <a
              href={site.github}
              class="underline decoration-current/30 underline-offset-4 hover:text-mauve-950 hover:decoration-current dark:hover:text-white"
            >
              Open a pull request
            </a>
            .
          </p>
        </div>
        <div class="grid grid-cols-2 gap-x-16 gap-y-2 text-sm/6 sm:grid-cols-3">
          {[...nav, { href: '/newsletter', label: 'Newsletter' }].map(
            (item) => (
              <a
                href={item.href}
                class="text-mauve-600 transition-colors hover:text-mauve-950 dark:text-mauve-400 dark:hover:text-white"
              >
                {item.label}
              </a>
            ),
          )}
        </div>
      </div>
      <div class="mt-12 flex flex-col-reverse gap-4 text-[0.8125rem]/6 text-mauve-500 sm:flex-row sm:items-center sm:justify-between">
        <p>
          Research checked 7 October 2026; activity and availability can change.
          Elixir and the Elixir logo are trademarks of The Elixir Team.
        </p>
        <div class="flex items-center gap-4">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a
            href="/rss.xml"
            class="flex items-center gap-1.5 hover:text-mauve-950 dark:hover:text-white"
          >
            <Icon name="rss" class="size-3.5" /> RSS
          </a>
          <a
            href={site.github}
            class="flex items-center gap-1.5 hover:text-mauve-950 dark:hover:text-white"
          >
            <Icon name="github" class="size-3.5" /> GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
