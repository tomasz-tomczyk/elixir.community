---
import Icon from '@/components/Icon.astro'
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle dark mode"
  class="group grid size-9 place-items-center rounded-full text-mauve-500 transition hover:bg-mauve-950/5 hover:text-mauve-950 dark:text-mauve-400 dark:hover:bg-white/5 dark:hover:text-white"
>
  <Icon name="sun" class="size-4 dark:hidden" />
  <Icon name="moon" class="hidden size-4 dark:block" />
</button>

<script>
  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark')
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light')
      } catch {}
    })
  }
</script>
