---
import { getCollection } from 'astro:content'

import Glow from '@/components/Glow.astro'
import Icon from '@/components/Icon.astro'
import SubscribeForm from '@/components/SubscribeForm.astro'
import { formatDate, issueNumber } from '@/lib/site'

interface Props {
  heading?: 'h1' | 'h2'
}

const { heading: Heading = 'h2' } = Astro.props
const issues = (await getCollection('issues')).sort(
  (a, b) => b.data.number - a.data.number,
)
const latest = issues[0]!
---

<section
  id="subscribe"
  class="relative isolate overflow-hidden rounded-3xl bg-mauve-950 px-6 py-14 shadow-2xl shadow-accent-950/20 ring-1 ring-white/10 sm:px-12 sm:py-16 lg:px-16 dark:bg-white/[0.03]"
>
  <Glow class="-top-1/2 -right-1/3 -z-10 h-[200%] w-[140%]" />
  <div class="bg-dots absolute inset-0 -z-10 [mask-image:radial-gradient(60%_60%_at_80%_20%,black,transparent)]"></div>
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-linear-to-r from-transparent via-accent-300/40 to-transparent"></div>

  <div class="grid items-center gap-x-16 gap-y-14 lg:grid-cols-[1fr_22rem]">
    <div class="max-w-xl">
      <p class="flex items-center gap-2 text-sm/6 font-medium text-accent-300">
        <Icon name="mail" class="size-4" />
        Newsletter
      </p>
      <Heading class="mt-5 font-display text-4xl/tight font-semibold tracking-tighter text-balance text-white sm:text-5xl/tight">
        The Elixir week,{' '}
        <span class="text-accent-300">in one short email.</span>
      </Heading>
      <p class="mt-5 max-w-lg text-base/7 text-mauve-300">
        Every so often we read the releases, posts, talks, and job boards, and
        send you the few things worth your time. Five minutes to read.
      </p>
      <SubscribeForm tone="dark" class="mt-8 max-w-md" />
      <p class="mt-4 text-[0.8125rem]/6 text-mauve-500">
        Free. Unsubscribe with one click. Read the{' '}
        <a
          href="/newsletter"
          class="text-mauve-400 underline decoration-mauve-500/40 underline-offset-4 transition hover:text-white hover:decoration-white/40"
        >
          archive
        </a>{' '}
        first.
      </p>
    </div>

    {/* The latest issue as a stack of paper, so people can see what they get. */}
    <a
      href={`/newsletter/${latest.id}`}
      class="group relative mx-auto block w-full max-w-sm lg:mx-0"
      aria-label={`Read issue ${latest.data.number}: ${latest.data.title}`}
    >
      <div class="absolute inset-x-6 -bottom-3 h-full rotate-2 rounded-2xl bg-white/5 ring-1 ring-white/10 transition duration-300 group-hover:rotate-3"></div>
      <div class="absolute inset-x-3 -bottom-1.5 h-full -rotate-1 rounded-2xl bg-white/10 ring-1 ring-white/10 transition duration-300 group-hover:-rotate-2"></div>
      <div class="relative rounded-2xl bg-white p-6 shadow-xl ring-1 shadow-black/20 ring-mauve-950/5 transition duration-300 group-hover:-translate-y-1">
        <div class="flex items-center justify-between font-mono text-2xs text-mauve-500">
          <span>{issueNumber(latest.data.number)}</span>
          <time datetime={latest.data.date.toISOString()}>
            {formatDate(latest.data.date, 'short')}
          </time>
        </div>
        <p class="mt-4 font-display text-lg/6 font-semibold tracking-tight text-mauve-950">
          {latest.data.title}
        </p>
        <p class="mt-3 line-clamp-3 text-sm/6 text-mauve-600">
          {latest.data.summary}
        </p>
        <div class="mt-5 space-y-2" aria-hidden="true">
          <div class="h-1.5 w-full rounded-full bg-mauve-100"></div>
          <div class="h-1.5 w-11/12 rounded-full bg-mauve-100"></div>
          <div class="h-1.5 w-2/3 rounded-full bg-mauve-100"></div>
        </div>
        <div class="mt-6 flex items-center justify-between border-t border-mauve-950/5 pt-4">
          <div class="flex gap-1.5">
            {latest.data.topics.map((t) => (
              <span class="rounded-full bg-accent-50 px-2 py-0.5 text-2xs font-medium text-accent-700">
                {t}
              </span>
            ))}
          </div>
          <span class="flex items-center gap-1 text-xs font-semibold text-mauve-950">
            Read
            <Icon
              name="arrow"
              class="size-3.5 transition-transform group-hover:translate-x-0.5"
            />
          </span>
        </div>
      </div>
    </a>
  </div>
</section>
