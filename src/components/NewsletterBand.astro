---
import SubscribeForm from '@/components/SubscribeForm.astro'

interface Props {
  title?: string
}
const { title = 'Get the best of this page in the occasional email.' } =
  Astro.props
---

<aside class="relative mt-24 flex flex-col gap-6 overflow-hidden rounded-[20px] bg-(--ec-surface) px-6 py-8 ring-1 ring-(--ec-line) sm:px-10 lg:flex-row lg:items-center lg:justify-between">
  <div>
    <p class="font-display text-xl/7 font-semibold tracking-tight text-balance text-(--ec-fg) sm:text-2xl/8">
      {title}
    </p>
  </div>
  <SubscribeForm class="w-full flex-none lg:max-w-md" />
</aside>
