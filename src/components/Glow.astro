---
// Radial glow from the Commit template, recolored to the Elixir accent.
interface Props {
  class?: string
}
const { class: className } = Astro.props
const id = `glow-${Math.random().toString(36).slice(2, 8)}`
---

<svg
  aria-hidden="true"
  class:list={['pointer-events-none absolute', className]}
>
  <defs>
    <radialGradient id={id} cx="100%" cy="0%">
      <stop offset="0%" stop-color="oklch(71.2% 0.16 304 / 0.35)"></stop>
      <stop offset="54%" stop-color="oklch(46% 0.18 301 / 0.1)"></stop>
      <stop offset="100%" stop-color="oklch(14.5% 0.008 326 / 0)"></stop>
    </radialGradient>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>
