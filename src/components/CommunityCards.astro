---
// Four places to talk with other Elixir developers. Each card is a speech bubble in its platform's colour,
// over a doodle pattern from public/patterns (made by scripts/patterns.mjs).
// Links come from the elixir-lang.org home page. The Slack, Discord and Reddit marks are from Simple Icons (CC0).

// The Slack mark in its four colours, one pair of shapes per colour.
const slackParts = [
  {
    color: '#e01e5a',
    d: 'M5.04 15.17a2.53 2.53 0 1 1-2.52-2.53h2.52v2.53ZM6.31 15.17a2.53 2.53 0 0 1 5.06 0v6.31a2.53 2.53 0 1 1-5.06 0v-6.31Z',
  },
  {
    color: '#36c5f0',
    d: 'M8.84 5.04a2.53 2.53 0 1 1 2.53-2.52v2.52H8.84ZM8.84 6.31a2.53 2.53 0 0 1 0 5.06H2.53a2.53 2.53 0 1 1 0-5.06h6.31Z',
  },
  {
    color: '#2eb67d',
    d: 'M18.96 8.84a2.53 2.53 0 1 1 2.52 2.53h-2.52V8.84ZM17.69 8.84a2.53 2.53 0 0 1-5.06 0V2.53a2.53 2.53 0 1 1 5.06 0v6.31Z',
  },
  {
    color: '#ecb22e',
    d: 'M15.16 18.96a2.53 2.53 0 1 1-2.53 2.52v-2.52h2.53ZM15.16 17.69a2.53 2.53 0 0 1 0-5.06h6.31a2.53 2.53 0 1 1 0 5.06h-6.31Z',
  },
]
const discordPath =
  'M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z'

const redditPath =
  'M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z'

const cards = [
  {
    key: 'slack',
    title: 'Slack',
    cta: 'Get an invite',
    href: 'https://elixir-slack.community',
  },
  {
    key: 'discord',
    title: 'Discord',
    cta: 'Join the server',
    href: 'https://discord.gg/elixir',
  },
  {
    key: 'forum',
    title: 'Elixir Forum',
    cta: 'Visit the forum',
    href: 'https://elixirforum.com',
  },
  {
    key: 'reddit',
    title: 'r/elixir',
    cta: 'Visit the subreddit',
    href: 'https://www.reddit.com/r/elixir',
  },
]
---

<ul class="grid gap-x-3 gap-y-7 md:grid-cols-2 xl:grid-cols-4">
  {cards.map((card) => (
    <li>
      <a
        href={card.href}
        target="_blank"
        rel="noopener"
        class:list={['chat', card.key]}
      >
        <span class="texture" aria-hidden="true" />
        <span class="mark" aria-hidden="true">
          {card.key === 'slack' && (
            <svg viewBox="0 0 24 24">
              {slackParts.map((part) => (
                <path d={part.d} fill={part.color} />
              ))}
            </svg>
          )}
          {card.key === 'discord' && (
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d={discordPath} />
            </svg>
          )}
          {card.key === 'reddit' && (
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d={redditPath} />
            </svg>
          )}
          {card.key === 'forum' && (
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 5.5h16v10H9l-5 4Z" />
              <path d="M8 9h8M8 12h5" />
            </svg>
          )}
        </span>
        <h3>{card.title}</h3>
        <span class="go">
          <span class="cta">{card.cta} &nearr;</span>
          <span class="typing" aria-hidden="true">
            <i />
            <i />
            <i />
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .chat {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-height: 15rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: 28px 28px 28px 6px;
    transition: transform 0.35s var(--ec-ease);
  }

  .chat:hover {
    transform: translateY(-4px) rotate(-1deg);
  }

  li:nth-child(even) .chat:hover {
    transform: translateY(-4px) rotate(1deg);
  }

  /* The tail of the speech bubble. */
  .chat::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -14px;
    width: 22px;
    height: 16px;
    background: inherit;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .texture {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    mask-image: linear-gradient(200deg, #000 25%, #0008 80%);
  }

  .slack {
    background: #4a154b;
    color: white;
  }

  .slack .texture {
    background:
      radial-gradient(40% 50% at 0 0, #36c5f033, #0000 70%),
      radial-gradient(45% 55% at 100% 100%, #ecb22e2e, #0000 70%),
      url(/patterns/slack.svg) -20px -30px / 236px 236px;
  }

  .discord {
    background: linear-gradient(160deg, #5865f2, #3c45c5);
    color: white;
  }

  .discord .texture {
    background:
      radial-gradient(60% 60% at 85% 10%, #ffffff33, #0000 60%),
      url(/patterns/discord.svg) -40px -10px / 236px 236px;
  }

  .forum {
    background: var(--ec-orchid);
    color: var(--ec-ink);
  }

  .forum .texture {
    background:
      radial-gradient(
        70% 60% at 100% 0%,
        rgb(255 255 255 / 0.35),
        transparent 70%
      ),
      url(/patterns/forum.svg) -10px -40px / 236px 236px;
  }

  .reddit {
    background: linear-gradient(160deg, #ff5700, #e03d00);
    color: white;
  }

  .reddit .texture {
    background:
      radial-gradient(60% 60% at 90% 0%, #ffffff30, #0000 60%),
      url(/patterns/reddit.svg) -30px -20px / 236px 236px;
  }

  /* The platform logo on a white tile, like an app icon. */
  .mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: white;
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.45);
  }

  .discord .mark {
    color: #5865f2;
  }

  .reddit .mark {
    color: #ff4500;
  }

  .forum .mark {
    color: var(--ec-violet);
  }

  .mark svg {
    width: 2rem;
    height: 2rem;
  }

  h3 {
    margin-top: auto;
    padding-top: 1.75rem;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    font-weight: 690;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .go {
    margin-top: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cta {
    padding: 0.5625rem 0.875rem;
    border-radius: 99px;
    font-size: 0.9375rem;
    font-weight: 640;
    background: rgb(255 255 255 / 0.16);
  }

  .forum .cta {
    background: var(--ec-ink);
    color: white;
  }

  /* "Someone is typing" dots, shown on hover. */
  .typing {
    display: inline-flex;
    gap: 4px;
    padding: 8px 10px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.16);
    opacity: 0;
    transform: translateY(4px);
    transition: 0.25s;
  }

  .forum .typing {
    background: rgb(255 255 255 / 0.5);
  }

  .typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: dot 1s infinite;
  }

  .typing i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .typing i:nth-child(3) {
    animation-delay: 0.3s;
  }

  .chat:hover .typing,
  .chat:focus-visible .typing {
    opacity: 0.9;
    transform: none;
  }

  @keyframes dot {
    50% {
      transform: translateY(-3px);
      opacity: 0.4;
    }
  }

  /* Phones: the name sits next to the logo, so the cards are shorter. */
  @media (max-width: 767px) {
    .chat {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 1rem;
      min-height: 0;
    }

    h3 {
      margin-top: 0;
      padding-top: 0;
      font-size: 2.25rem;
    }

    .go {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat:hover,
    li:nth-child(even) .chat:hover {
      transform: none;
    }
  }
</style>
