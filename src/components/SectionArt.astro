---
// The section's home page tile drawing, bigger, straight on the page in the
// section's colour. Sits beside the title in a page header (PageHeader's "aside" slot).
import TilePic, { type PicKind } from '@/components/TilePic.astro'

interface Props {
  kind: PicKind
  class?: string
}
const { kind, class: className } = Astro.props
---

<div
  class:list={['ec-art ec-rise', `ec-art-${kind}`, className]}
  aria-hidden={kind === 'people' ? undefined : 'true'}
>
  <TilePic kind={kind} />
</div>

<style is:global>
  .ec-art {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 26rem;
    margin-inline: auto;
    /* The drawings use --tx for ink and --bg for cut-outs (the play arrow, the
       conference ring), so point them at the section colour and the page. */
    --bg: var(--ec-bg);
    color: var(--tx);
    transition-delay: 0.08s;
  }

  .ec-art-events,
  .ec-art-podcasts {
    --tx: var(--ec-fuchsia);
  }

  .ec-art-resources,
  .ec-art-companies {
    --tx: var(--ec-violet);
  }

  .ec-art-youtube,
  .ec-art-books,
  .ec-art-people {
    --tx: var(--ec-indigo);
  }

  /* Dark mode: the lighter tones, so the drawings stay visible. */
  .dark .ec-art-events,
  .dark .ec-art-podcasts {
    --tx: var(--ec-blush);
  }

  .dark .ec-art-resources,
  .dark .ec-art-companies {
    --tx: var(--ec-lilac);
  }

  .dark .ec-art-youtube,
  .dark .ec-art-books,
  .dark .ec-art-people {
    --tx: var(--ec-periwinkle);
  }

  /* Sized to about the height of the page title, so these headers are no taller
     than the one on /jobs, which has no drawing. */
  .ec-art .ec-pic {
    width: 100%;
    margin: 0;
  }

  .ec-art .ec-cal {
    max-width: 14rem;
  }

  .ec-art .ec-links {
    height: 2.5rem;
  }

  .ec-art .ec-play,
  .ec-art .ec-wave,
  .ec-art .ec-shelf {
    height: 4.5rem;
  }

  .ec-art .ec-skyline {
    justify-content: center;
    height: 6.5rem;
    margin: 0;
    padding: 0;
    /* The ground under the buildings. */
    border-bottom: 2px solid color-mix(in oklch, var(--tx) 35%, transparent);
  }

  /* Below the two-column header the drawing would sit under the title and add
     height, so it is hidden there. */
  @media (max-width: 1023px) {
    .ec-art {
      display: none;
    }
  }
</style>
