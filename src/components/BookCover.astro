---
import LocalImage from '@/components/LocalImage.astro'
import EntryDates from '@/components/EntryDates.astro'
import { edgeBackground } from '@/lib/edge-color'
// A book cover drawn with CSS in the site's tones. `index` picks the tone and the shape,
// so neighbouring books never share both.
interface Props {
  id?: string
  dates?: { last_updated?: string; created?: string; year?: number }
  image?: string
  title: string
  author: string
  href: string
  index: number
  level?: string
  year?: number
  note?: string
}
const { id, dates, image, title, author, href, index, level, year, note } =
  Astro.props

const tones = [
  'violet',
  'blush',
  'indigo',
  'orchid',
  'fuchsia',
  'peri',
  'deep',
  'lilac',
]
const shapes = ['circle', 'leaf', 'arch', 'quarter', 'drop']
const tone = tones[index % tones.length]
const shape = shapes[index % shapes.length]
// With an image, the cover takes the image's own edge colours instead of the tone.
// Covers are wider than the 2:3 box, so the gaps are above and below.
const imageBg = image && (await edgeBackground(image, { split: true }))
---

<a
  id={id}
  href={href}
  target="_blank"
  rel="noopener"
  class="group row-span-2 grid grid-rows-subgrid gap-4"
>
  <div
    class:list={['book self-end', `k-${tone}`]}
    style={imageBg && `--bg: ${imageBg}`}
  >
    {image ? (
      <LocalImage
        src={image}
        widths={[160, 240, 320, 480]}
        sizes="(min-width: 1024px) 220px, (min-width: 640px) 30vw, 45vw"
        alt={`${title} cover`}
        loading="lazy"
        class="size-full object-contain"
      />
    ) : (
      <span class="grid h-full place-items-center p-4 text-center">
        {title}
      </span>
    )}
  </div>
  <div>
    <p class="text-[0.9375rem]/6 font-semibold tracking-tight text-(--ec-fg) decoration-(--ec-fuchsia) underline-offset-3 group-hover:underline">
      {title}
    </p>
    <p class="text-sm/6 text-(--ec-muted)">{author}</p>
    {dates && <EntryDates data={dates} createdLabel="Published" />}
    {note && <p class="text-xs/5 text-(--ec-muted)">{note}</p>}
    {(year || level) && (
      <p class="mt-1 flex gap-2 font-mono text-[0.75rem]/5 text-(--ec-muted)">
        {level && <span>{level}</span>}
      </p>
    )}
  </div>
</a>

<style>
  .book {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    border-radius: 6px 16px 16px 6px;
    color: var(--tx);
    background: var(--bg);
    box-shadow: 0 18px 36px -20px rgb(20 0 40 / 0.55);
    transition: transform 0.35s var(--ec-ease);
  }

  .shape {
    position: absolute;
    right: -12%;
    bottom: -8%;
    width: 72%;
    aspect-ratio: 1;
    background: color-mix(in oklch, var(--tx) 16%, transparent);
    transition:
      border-radius 0.5s var(--ec-ease),
      rotate 0.5s var(--ec-ease);
  }

  .circle {
    border-radius: 50%;
  }

  .leaf {
    border-radius: 0 100% 0 100%;
  }

  .arch {
    height: 36%;
    aspect-ratio: auto;
    bottom: -2%;
    border-radius: 999px 999px 0 0;
  }

  .quarter {
    right: -4%;
    bottom: -4%;
    border-radius: 100% 0 0 0;
  }

  .drop {
    border-radius: 50% 0 50% 50%;
    rotate: -45deg;
  }

  .group:hover .book {
    transform: translateY(-6px) rotate(-1.5deg);
  }

  .group:hover .shape {
    border-radius: 18px;
    rotate: 12deg;
  }
</style>
