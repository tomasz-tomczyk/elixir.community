export type IconName = keyof typeof paths | keyof typeof social

interface Props {
  name: IconName
  class?: string
}

const { name, class: className = 'h-4 w-4' } = Astro.props
const isSocial = name in social
---

<svg
  viewBox={isSocial ? '0 0 24 24' : '0 0 16 16'}
  fill="none"
  stroke="currentColor"
  stroke-width={isSocial ? 2 : 1.5}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['flex-none', className]}
>
  <path
    d={
      isSocial
        ? social[name as keyof typeof social]
        : paths[name as keyof typeof paths]
    }
  ></path>
</svg>
