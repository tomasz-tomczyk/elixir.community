---
import { getCollection } from 'astro:content'

import ConferenceCard from '@/components/ConferenceCard.astro'
import ContentLink from '@/components/ContentLink.astro'
import ContributeNote from '@/components/ContributeNote.astro'
import NewsletterBand from '@/components/NewsletterBand.astro'
import PageHeader from '@/components/PageHeader.astro'
import SectionArt from '@/components/SectionArt.astro'
import PageSection from '@/components/PageSection.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { isUpcoming } from '@/lib/site'

const events = await getCollection('events')
const upcoming = events
  .filter((e) => e.data.kind === 'conference' && (isUpcoming(e.data.date) || (!e.data.date && !!e.data.when)))
  .sort((a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? ''))
const pastCount = events.filter(
  (e) => e.data.kind === 'conference' && !isUpcoming(e.data.date) && !e.data.when,
).length
const meetups = events.filter((e) => e.data.kind === 'meetup')
---

<BaseLayout
  title="Events"
  description="Upcoming Elixir conferences and meetups, online and around the world."
>
  <div class="container-page">
    <PageHeader title="Elixir Events">
      <SectionArt slot="aside" kind="events" />
    </PageHeader>

    <div>
      <PageSection
        id="conferences"
        title="Upcoming conferences"
        href="/events/archive"
        linkLabel={`Archive (${pastCount})`}
      >
        {upcoming.length > 0 ? (
          <ul class="grid gap-5 md:grid-cols-2">
            {upcoming.map((c) => (
              <li>
                <ConferenceCard
                  id={c.id}
                  dates={c.data}
                  image={c.data.image}
                  name={c.data.name}
                  url={c.data.url}
                  location={c.data.location}
                  date={c.data.date}
                  description={c.data.description}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base/7 text-(--ec-muted)">
            No conference dates are announced right now. The newsletter covers
            new dates as soon as they appear.
          </p>
        )}
      </PageSection>

      <PageSection
        id="meetups"
        title="Meetups"
        description="Local groups and online sessions. Dates are individually checked, not inferred from a recurring cadence."
      >
        <ul class="ec-rows max-w-3xl border-t border-(--ec-line)">
          {meetups.map((m) => (
            <li>
              {m.data.image && <img src={m.data.image} alt="" loading="lazy" class="float-right mt-4 size-12 rounded-lg object-contain" />}
              <ContentLink
                id={m.id}
                dates={m.data}
                href={m.data.url}
                title={m.data.name}
                meta={[m.data.location, m.data.when]
                  .filter(Boolean)
                  .join(' · ')}
                description={m.data.description}
                icon="pin"
              />
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm/6 text-(--ec-muted)">Historical research: <a href="/research/elixir-global-meetup-campaign.csv" class="underline">2025 global campaign</a> and <a href="/research/elixir-meetup-candidates.csv" class="underline">unconfirmed candidate queue</a>. These are not active-meetup lists.</p>
        <ContributeNote question="Run a meetup that is not here?" />
      </PageSection>
    </div>

    <NewsletterBand title="New meetups and conference dates, now and then." />
  </div>
</BaseLayout>
