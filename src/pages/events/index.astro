---
import { getCollection } from 'astro:content'

import ConferenceCard from '@/components/ConferenceCard.astro'
import ContentLink from '@/components/ContentLink.astro'
import ContributeNote from '@/components/ContributeNote.astro'
import NewsletterBand from '@/components/NewsletterBand.astro'
import PageHeader from '@/components/PageHeader.astro'
import SectionArt from '@/components/SectionArt.astro'
import PageSection from '@/components/PageSection.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  continentOf,
  continentOrder,
  flagOf,
  formatDate,
  isUpcoming,
  place,
} from '@/lib/site'

const events = await getCollection('events')
// Conferences with only a rough date ("May 2027, exact dates TBD") sort by that month.
const sortKey = (d: { date?: string; when?: string }) => {
  if (d.date) return d.date
  const month = new Date(`${d.when?.split(',')[0]} UTC`)
  return isNaN(+month) ? '9' : month.toISOString().slice(0, 10)
}
const upcoming = events
  .filter(
    (e) =>
      e.data.kind === 'conference' &&
      (isUpcoming(e.data.date) || (!e.data.date && !!e.data.when)),
  )
  .sort((a, b) => sortKey(a.data).localeCompare(sortKey(b.data)))
const pastCount = events.filter(
  (e) =>
    e.data.kind === 'conference' && !isUpcoming(e.data.date) && !e.data.when,
).length

// Meetups by continent. In each, the next confirmed date first, then by name.
const todayIso = new Date().toISOString().slice(0, 10)
const nextDate = (date?: string) =>
  date && date >= todayIso ? date : undefined
const meetups = events
  .filter((e) => e.data.kind === 'meetup')
  .sort(
    (a, b) =>
      (nextDate(a.data.date) ?? '9').localeCompare(
        nextDate(b.data.date) ?? '9',
      ) || a.data.name.localeCompare(b.data.name),
  )
const regions = continentOrder
  .map((name) => ({
    name,
    meetups: meetups.filter((m) => continentOf(m.data.country) === name),
  }))
  .filter((r) => r.meetups.length > 0)
---

<BaseLayout
  title="Events"
  description="Upcoming Elixir conferences and meetups, online and around the world."
>
  <div class="container-page">
    <PageHeader title="Elixir Events">
      <SectionArt slot="aside" kind="events" />
    </PageHeader>

    <div>
      <PageSection
        id="conferences"
        title="Upcoming conferences"
        href="/events/archive"
        linkLabel={`Archive (${pastCount})`}
      >
        {upcoming.length > 0 ? (
          <ul class="grid gap-5 md:grid-cols-2">
            {upcoming.map((c) => (
              <li>
                <ConferenceCard
                  id={c.id}
                  dates={c.data}
                  name={c.data.name}
                  url={c.data.url}
                  location={place(c.data)}
                  date={c.data.date}
                  description={c.data.description}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base/7 text-(--ec-muted)">
            No conference dates are announced right now. The newsletter covers
            new dates as soon as they appear.
          </p>
        )}
      </PageSection>

      <PageSection id="meetups" title="Meetups">
        {regions.map((region) => (
          <section
            aria-labelledby={`region-${region.name}`}
            class="mt-10 first:mt-0"
          >
            <h3 id={`region-${region.name}`} class="ec-sched-sub">
              {region.name}
            </h3>
            <ul class="ec-rows max-w-3xl border-t border-(--ec-line)">
              {region.meetups.map((m) => {
                const next = nextDate(m.data.date)
                return (
                  <li>
                    <ContentLink
                      id={m.id}
                      dates={m.data}
                      href={m.data.url}
                      title={m.data.name}
                      meta={[
                        place(m.data),
                        next &&
                          formatDate(new Date(`${next}T00:00:00Z`), 'short'),
                      ]
                        .filter(Boolean)
                        .join(' · ')}
                      description={m.data.description}
                      icon="globe"
                      emoji={flagOf(m.data.country)}
                    />
                  </li>
                )
              })}
            </ul>
          </section>
        ))}
        <ContributeNote question="Run a meetup that is not here?" />
      </PageSection>
    </div>

    <NewsletterBand title="New meetups and conference dates, now and then." />
  </div>
</BaseLayout>
