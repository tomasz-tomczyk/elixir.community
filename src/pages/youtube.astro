---
import { getCollection } from 'astro:content'

import ContributeNote from '@/components/ContributeNote.astro'
import MediaCard from '@/components/MediaCard.astro'
import NewsletterBand from '@/components/NewsletterBand.astro'
import PageHeader from '@/components/PageHeader.astro'
import PageSection from '@/components/PageSection.astro'
import TalkList from '@/components/TalkList.astro'
import SectionArt from '@/components/SectionArt.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { formatDate } from '@/lib/site'

const channels = (await getCollection('youtube')).sort(
  (a, b) => +(b.data.last_video ?? 0) - +(a.data.last_video ?? 0),
)
const talks = (await getCollection('talks')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
)
const people = await getCollection('people')
const meta = (c: (typeof channels)[number]) =>
  [
    c.data.videos && `${c.data.videos.toLocaleString('en-US')} videos`,
    c.data.last_video &&
      `Last upload: ${formatDate(c.data.last_video, 'short')}`,
  ]
    .filter(Boolean)
    .join('  ·  ')
---

<BaseLayout
  title="YouTube"
  description="YouTube channels with Elixir conference talks, tutorials, and screencasts."
>
  <div class="container-page">
    <PageHeader title="Elixir on YouTube">
      <SectionArt slot="aside" kind="youtube" />
    </PageHeader>

    <nav aria-label="YouTube sections" class="mt-8 flex flex-wrap gap-3">
      <a href="#channels" class="btn-soft">
        Channels
      </a>
      <a href="#talks" class="btn-soft">
        Talks
      </a>
    </nav>

    <PageSection id="channels" title="Channels">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {channels.map((c, i) => (
          <MediaCard
            id={c.id}
            dates={c.data}
            image={c.data.image}
            href={c.data.url}
            title={c.data.title}
            description={c.data.description}
            index={i}
            meta={meta(c)}
          />
        ))}
      </div>
    </PageSection>

    <PageSection id="talks" title="Talks">
      <TalkList talks={talks} people={people} />
    </PageSection>

    <ContributeNote question="Know a channel or talk that is not here?" />

    <NewsletterBand title="The talks worth watching, now and then." />
  </div>
</BaseLayout>
