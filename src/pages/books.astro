---
import { getCollection } from 'astro:content'

import BookCover from '@/components/BookCover.astro'
import ContributeNote from '@/components/ContributeNote.astro'
import NewsletterBand from '@/components/NewsletterBand.astro'
import PageHeader from '@/components/PageHeader.astro'
import SectionArt from '@/components/SectionArt.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const books = (await getCollection('books')).sort(
  (a, b) =>
    (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.title.localeCompare(b.data.title),
)
---

<BaseLayout
  title="Books"
  description="Elixir books the community recommends, from your first function to OTP design."
>
  <div class="container-page">
    <PageHeader title="Elixir Books">
      <SectionArt slot="aside" kind="books" />
    </PageHeader>

    <div class="ec-rise mt-16 grid grid-cols-2 gap-x-5 gap-y-12 border-t border-(--ec-line) pt-12 sm:gap-x-8 md:grid-cols-3 lg:grid-cols-5">
      {books.map((b, i) => (
        <BookCover
          image={b.data.image}
          title={b.data.title}
          author={b.data.author}
          href={b.data.url}
          index={i}
          level={b.data.level}
          year={b.data.year}
        />
      ))}
    </div>

    <ContributeNote question="Know a book that is not here?" />

    <NewsletterBand title="A chapter worth your evening, now and then." />
  </div>
</BaseLayout>
